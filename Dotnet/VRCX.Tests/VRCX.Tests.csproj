<!-- 设计稿 (Stage 2 solutions-architect 输出, Link+stub 方案)
  - 文件名: VRCX.Tests.csproj
  - 用途: 7.5.9 Phase — VRCX-K 首个 C# 测试工程，覆盖 SQLite 安全加固 42 用例
  - 最终位置: Dotnet/VRCX.Tests/VRCX.Tests.csproj (由 implementer 决定)
  - 依赖策略: Link ..\SQLite.cs + 测试工程内 Program/VRCXStorage stub (不 ProjectReference Cef)
  - 关键决策:
      * Link SQLite.cs (Compile Include + Link) — SQLite 类被编译进 VRCX.Tests.dll 同 assembly
        → 不需要 [InternalsVisibleTo] (同 assembly internal 直接可见)
        → 不拉入 Cef 的 windows TFM + CefSharp + Silk.NET + System.Management 依赖
      * TFM net10.0 (无 -windows 后缀, 跨平台; 安全方法仅依赖 BCL 跨平台 API)
      * xUnit 2.9.2 + FluentAssertions 6.12.2 (FA 7.x 对 .NET 10 支持待验证, 先用 6.x 稳定版)
      * Coverlet 6.0.2 (无 threshold, 仅收集)
      * System.Data.SQLite 2.0.3 — SQLite.cs Init() 引用 SQLiteConnection; v2.0.3 targets
        netstandard2.0 (No dependencies), 纯 managed, 跨平台; 安全测试不调 Init(), 不需 native 运行时
      * AssemblyName 仍设 "VRCX.Tests" — 命名一致性 (虽不再需要 InternalsVisibleTo 匹配)
      * Stubs\ 路径 — 最终位置 Dotnet/VRCX.Tests/Stubs/, 设计稿阶段 stub 文件在 docs/phase7_5_design/ 平铺
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>VRCX.Tests</AssemblyName>
    <RootNamespace>VRCX.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <!-- Suppress nullable static-analysis warnings (CS8618 uninitialized fields/props,
         CS8603 possible null return) that arise from:
           1. Stubs' by-design fields (Program.AppDataDirectory / ConfigLocation are assigned
              in test Setup, not at field declaration; VRCXStorage.Get intentionally returns
              null as fail-fast sentinel).
           2. Link'd SQLite.cs _connectionString field (initialized in Init(), not ctor; security
              tests never call Init() so the field stays null at test time — by design).
         CS8601 (possible null assignment) is suppressed because the DBNull normalization
         (`reader.IsDBNull(i) ? null : reader.GetValue(i)`, L583/683/898) intentionally puts
         null into the object[] row buffer — the marshaling layer must carry NULL to JS.
         This mirrors the long-standing MySQL.cs L353 pattern (VRCX-Cef.csproj disables
         warnings entirely via WarningLevel=0; the linked test build needs the explicit
         suppression).
         Task constraint forbids modifying stub content; suppressing here is the minimal fix.
         CS8625/CS8600/CS8604/CS8605 (PR #17 回归测试接入 PostgreSQL.cs/MySQL.cs 后新增,
         2026-08-07): 与上述同类的 nullable 静态分析告警, 来源为 Link'd 生产文件:
         CS8625 — SQLite.cs L479 / MySQL.cs L339 / PostgreSQL.cs L693/856/882 向
         string? 签名传 null 字面量 (生产构建 WarningLevel=0 不报, 测试构建需显式抑制)
         CS8604 — PostgreSQL.cs L440/443/447 Init() 中 VRCXStorage.Instance.Get()?.Trim()
         → ValidateField/ValidatePort 形参可空 (Init 不被测试调用, 静态告警仅编译期)
         CS8605 — PostgreSQL.cs L702 反射/强制类型转换路径上解箱可能为 null
         CS8600 — 三引擎 Execute 路径中 arg.Value/GetValue 转非空类型 (测试不触达该路径)
         均不改生产代码, 按既有 NoWarn 政策扩展. -->
    <NoWarn>CS8618;CS8603;CS8601;CS8625;CS8604;CS8605;CS8600</NoWarn>
    <!-- 不设 EnableWindowsTargeting，TFM 无 -windows 后缀，可在 Linux CI 跑 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <!-- NLog 6.1.3 (与生产 pin 一致, 见 VRCX-Cef.csproj L104) —
         M1 S2 NodeMode.cs 非法值 logger.Warn 使用 LogManager.GetCurrentClassLogger。
         无 NLog.config 时日志为 no-op, 不影响断言。 -->
    <PackageReference Include="NLog" Version="6.1.3" />
    <!-- System.Data.SQLite needed because Link'd SQLite.cs references SQLiteConnection in Init().
         v2.0.3 targets netstandard2.0 (No dependencies), pure managed, cross-platform.
         Security tests don't call Init(), so native SQLite runtime is NOT required at test time.
         M1 S2 browse 真库测试会真实打开连接, 需要 native SQLite.Interop.dll (win-x64 由包内
         build targets 拷贝到输出目录)。 -->
    <PackageReference Include="System.Data.SQLite" Version="2.0.3" />
    <!-- Npgsql 10.0.3 + MySqlConnector 2.6.1 (与生产 pin 一致, 见 VRCX-Cef.csproj L105/114):
         Link'd PostgreSQL.cs / MySQL.cs 引用 NpgsqlDataSource / MySqlConnection 等类型。
         PR #17 回归测试只触达 NormalizeConnId (静态纯函数) 与 Execute* 的
         connId 归一化早抛点, 不建立真实连接, 故不触发 native 运行时。 -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <!-- SourceGear.sqlite3 3.50.4.5 (与生产 pin 一致, 见 VRCX-Cef.csproj L112):
         System.Data.SQLite 2.0.3 托管层 P/Invoke 原生 e_sqlite3 库;M1 S2 browse 真库
         测试 (INSERT/DDL readonly 拒绝 / SELECT 正常) 需要真实打开连接, 由本包提供
         runtimes/win-x64/native/e_sqlite3.dll。 -->
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link SQLite.cs from Dotnet/ (compiles into VRCX.Tests.dll, no ProjectReference to Cef).
         Avoids pulling Cef's windows TFM + CefSharp + Silk.NET + System.Management deps.
         Note: Stubs\*.cs are NOT listed here — .NET SDK implicitly includes all .cs files
         under the project directory (EnableDefaultCompileItems=true). Adding explicit
         <Compile Include="Stubs\*.cs" /> would cause NETSDK1022 duplicate item errors. -->
    <Compile Include="..\SQLite.cs" Link="SQLite.cs" />
    <!-- IAuthStore interface is referenced by SQLite.cs (class now implements it).
         Linked into VRCX.Tests.dll so the test compile resolves the type without
         pulling in MySQL.cs / PostgreSQL.cs / WebApi.cs (pure interface, no deps). -->
    <Compile Include="..\IAuthStore.cs" Link="IAuthStore.cs" />
    <!-- PostgreSQL.cs / MySQL.cs Link 进来 (PR #17 回归测试, 同 assembly internal
         直接可见). 两文件自包含: 仅依赖 BCL + Npgsql/MySqlConnector + IAuthStore +
         VRCXStorage (Stubs\ 隐式编译). 桥接测试只反射触达 Execute* 的 connId 归一化
         早抛点, 不调 Init()/SetChangeEnabled, 不触碰 .Instance 静态。 -->
    <Compile Include="..\PostgreSQL.cs" Link="PostgreSQL.cs" />
    <Compile Include="..\MySQL.cs" Link="MySQL.cs" />
    <!-- NodeMode.cs Link 进来 (M1 S2): SQLite.Init() 浏览模式判定 + NodeModeTests 直接
         调用内部成员 (同 assembly 可见, 不需 InternalsVisibleTo)。依赖 NLog + VRCXStorage
         (Stubs\ 隐式编译)。 -->
    <Compile Include="..\NodeMode.cs" Link="NodeMode.cs" />
  </ItemGroup>

</Project>
